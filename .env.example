# Copiá este archivo a .env y completá tu API key. El .env NUNCA se sube ni se comparte.

LLM_PROVIDER=google

GOOGLE_API_KEY=
GOOGLE_MODEL_ID=gemini-3.5-flash-lite

# Embeddings. Si cambiás el modelo o la dimensión, hay que re-correr scripts/ingestar.py
# (vectores de modelos o dimensiones distintas no se pueden mezclar en el mismo índice).
GOOGLE_EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIM=768

# Rutas (relativas a la raíz del repo)
CORPUS_DIR=data/corpus
CHROMA_DIR=data/chroma
CHROMA_COLECCION=corpus_tp
